PORT=3003
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=storage_platform
DB_USER=admin
DB_PASSWORD=secret

# Storage (MinIO / RustFS)
STORAGE_TYPE=minio
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=savedimages

# Redis (Event Bus)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=super-secret-key-change-in-production
JWT_REFRESH_SECRET=refresh-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=d9b5bf0981315efee593a7b45eda8e501502d38a39b8ca1bf52da29d87287fbe

# Resize Config
RESIZE_SIZES=200x200,400x400,680x680
KEEP_ORIGINAL=true
RESIZED_PATH=/s