PORT=3003
NODE_ENV=production

# Database
DB_HOST=mysql
DB_PORT=3306
DB_NAME=resize_image
DB_USER=root
DB_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=resize_image

# Storage (MinIO)
STORAGE_TYPE=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=savedimages

# Redis (Event Bus)
REDIS_HOST=redis
REDIS_PORT=6379

# Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=d9b5bf0981315efee593a7b45eda8e501502d38a39b8ca1bf52da29d87287fbe

# Resize Config
RESIZE_SIZES=200x200,400x400,680x680
KEEP_ORIGINAL=true
RESIZED_PATH=/

# phpMyAdmin
PMA_HOST=mysql
PMA_USER=root
PMA_PASSWORD=root
